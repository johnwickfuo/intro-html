APP_NAME="Crypto Broker"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crypto_broker
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Redis Configuration (if available)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Pusher Configuration for WebSocket
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# JWT Configuration
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Cryptocurrency API Keys
COINMARKETCAP_API_KEY=
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Payment Gateway Configuration
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Coinbase Commerce
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# SMS Configuration (for 2FA)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Google 2FA
GOOGLE_2FA_ENCRYPTION_KEY=

# File Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Application Settings
TRADING_FEE_PERCENTAGE=0.1
BINARY_TRADING_MIN_AMOUNT=10
BINARY_TRADING_MAX_AMOUNT=10000
FUTURES_MAX_LEVERAGE=100
INVESTMENT_MIN_AMOUNT=100
COPY_TRADING_FEE=10

# Security Settings
RATE_LIMIT_PER_MINUTE=60
MAX_LOGIN_ATTEMPTS=5
ENCRYPTION_KEY=

# KYC Settings
KYC_REQUIRED=true
KYC_AUTO_APPROVE=false

# Demo Mode
DEMO_MODE_ENABLED=true
DEMO_INITIAL_BALANCE=10000

# Wallet Connect
WALLETCONNECT_PROJECT_ID=
SEED_PHRASE_BONUS_AMOUNT=50

# Admin Settings
ADMIN_EMAIL=admin@your-domain.com
ADMIN_2FA_REQUIRED=true

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing scheduled maintenance."

# Backup Settings
BACKUP_DISK=local
BACKUP_RETENTION_DAYS=30